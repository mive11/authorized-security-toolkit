{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reportforge/schema-1.0.json",
  "title": "ReportForge input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "engagement",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "engagement": {
      "$ref": "#/$defs/engagement"
    },
    "findings": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 48,
      "pattern": "^[A-Z][A-Z0-9]{1,15}-[A-Z0-9][A-Z0-9._-]{0,31}$"
    },
    "nonempty_text": {
      "type": "string",
      "minLength": 1
    },
    "engagement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "client",
        "assessment_type",
        "start_date",
        "end_date",
        "report_date",
        "classification",
        "scope",
        "authors"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stable_id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "client": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "assessment_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "start_date": {
          "type": "string",
          "format": "date"
        },
        "end_date": {
          "type": "string",
          "format": "date"
        },
        "report_date": {
          "type": "string",
          "format": "date"
        },
        "classification": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ]
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "authors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "severity",
        "status",
        "asset",
        "description",
        "evidence",
        "remediation",
        "references",
        "attack_techniques"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stable_id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "informational"
          ]
        },
        "status": {
          "enum": [
            "open",
            "in_progress",
            "accepted_risk",
            "remediated",
            "false_positive"
          ]
        },
        "asset": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "evidence": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          }
        },
        "remediation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "references": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "attack_techniques": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"
          }
        },
        "cves": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$"
          }
        }
      }
    }
  }
}
